Bootstrap: docker
From: python:3.11.8-slim-bookworm

%files
  requirements.txt /app/requirements.txt
  src /app/src
  res /app/res
  
%post
  apt-get update && apt-get install git -y && apt-get clean autoclean
  python -m venv /app/venv
  cd /app
  /app/venv/bin/pip install --no-cache-dir -r requirements.txt

%environment
  export PATH=/app/venv/bin:$PATH
  export PYTHONPATH=/app

%runscript
  cd /app
  /app/venv/bin/python -m src.main \
    --reading-mode file \
    --batch-mode count \
    --limit 100 \
    --readings-file res/readings_alpha_large.csv \
    --sensors-file res/sensors_alpha.yaml \
    --rules-file res/rules_alpha.json \
    --output-dir output_collector \
    --alarms-output-file alarms-output.txt \
    --valid-output-file valid_output.txt